// memset.hla64 — fill buffer[0..length] with value; return status 0 (SemASM/VAA bridge).
//
// Downstream: emit Win64 NASM → vaa ingest --generator hlax64
// Contract shape: (ptr<u8>, usize, u8) -> usize  (builtin.buffer.memset, void-as-count-0)
// Honesty: HlaX64 emit / -Wverify ≠ SemASM verified.
// Win64: only volatile regs (rax/rcx/rdx/r8-r11) — no r12–r15 clobber.
// Same bug class as replace_byte: the byte-store lowering can route the
// stored value through rax/al as scratch, so the constant status is only
// written to rax once, after the loop — never before it.

program memset;

export procedure memset(buffer: ptr; length: int64; value: int64); @returns("rax");
begin memset;
    mov(0, r9);
    mov(buffer, r10);

    while(r9 < length) do
        mov(value, [r10].byte);
        add(1, r9);
        add(1, r10);
    endwhile;

    mov(0, rax);
end memset;

begin memset;
end memset;
