// replace_byte.hla64 — replace needle with replacement in buffer[0..length]; return count (SemASM/VAA bridge).
//
// Downstream: emit Win64 NASM → vaa ingest --generator hlax64
// Contract shape: (ptr<u8>, usize, u8, u8) -> usize  (builtin.buffer.replace_byte)
// Honesty: HlaX64 emit / -Wverify ≠ SemASM verified.
// Win64: only volatile regs (rax/rcx/rdx/r8-r11) — no r12–r15 clobber.

program replace_byte;

export procedure replace_byte(buffer: ptr; length: int64; needle: int64; replacement: int64); @returns("rax");
begin replace_byte;
    mov(0, r8);
    mov(0, r9);
    mov(buffer, r10);

    while(r9 < length) do
        mov([r10].byte, r11);
        if(r11 = needle) then
            mov(replacement, [r10].byte);
            add(1, r8);
        endif;
        add(1, r9);
        add(1, r10);
    endwhile;

    mov(r8, rax);
end replace_byte;

begin replace_byte;
end replace_byte;
