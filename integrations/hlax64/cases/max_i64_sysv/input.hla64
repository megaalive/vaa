// max_i64.hla64 — return the larger of two signed 64-bit integers (SemASM/VAA bridge).
//
// Downstream: emit Win64 NASM → vaa ingest --generator hlax64
// Contract shape: (i64, i64) -> i64  (builtin.pure_int.binary_i64, claim "max")
// Honesty: HlaX64 emit / -Wverify ≠ SemASM verified.
// Signed compare (`>`) matches the `i64` contract type; the unsigned `>?`
// would misorder negative values (contrast with max_usize).
// Parameters may spill to the frame; mem-mem `cmp` bounces through a register.

program max_i64;

export procedure max_i64(a: int64; b: int64); @returns("rax");
begin max_i64;
    if(a > b) then
        mov(a, rax);
    else
        mov(b, rax);
    endif;
end max_i64;

begin max_i64;
end max_i64;
