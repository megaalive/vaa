// min_i64.hla64 — return the smaller of two signed 64-bit integers (SemASM/VAA bridge).
//
// Downstream: emit Win64 NASM → vaa ingest --generator hlax64
// Contract shape: (i64, i64) -> i64  (builtin.pure_int.binary_i64, claim "min")
// Honesty: HlaX64 emit / -Wverify ≠ SemASM verified.
// Win64: only volatile regs (rax/rcx/rdx/r8/r9) — a=rcx, b=rdx.
// Signed compare (`<`) matches the `i64` contract type; the unsigned `<?`
// would misorder negative values (contrast with min_usize).
// `a`/`b` are loaded into registers before the compare: comparing two
// stack-spilled parameters directly lowers to an invalid mem-mem `cmp`.

program min_i64;

export procedure min_i64(a: int64; b: int64); @returns("rax");
begin min_i64;
    mov(a, r8);
    mov(b, r9);
    if(r8 < r9) then
        mov(r8, rax);
    else
        mov(r9, rax);
    endif;
end min_i64;

begin min_i64;
end min_i64;
