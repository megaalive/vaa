// add_i64.hla64 — wrapping sum of two signed 64-bit integers (SemASM/VAA bridge).
//
// Downstream: emit Win64 NASM → vaa ingest --generator hlax64
// Contract shape: (i64, i64) -> i64  (builtin.pure_int.binary_i64, claim "wrapping_add")
// Honesty: HlaX64 emit / -Wverify ≠ SemASM verified.
// Win64: a=rcx, b=rdx; only volatile regs used. x86 `add` is wrapping
// two's-complement, matching the contract's wrapping_add claim.

program add_i64;

export procedure add_i64(a: int64; b: int64); @returns("rax");
begin add_i64;
    mov(a, rax);
    add(b, rax);
end add_i64;

begin add_i64;
end add_i64;
