// max_usize.hla64 — return the larger of two unsigned sizes (SemASM/VAA bridge).
//
// Downstream: emit Win64 NASM → vaa ingest --generator hlax64
// Contract shape: (usize, usize) -> usize  (builtin.pure_int.binary_usize, claim "max")
// Honesty: HlaX64 emit / -Wverify ≠ SemASM verified.
// Win64: prefer volatile regs in hand-written leaves when possible; the
// backend may bounce mem-mem `cmp` through a scratch register.
// Unsigned compare (`>?`) matches the `usize` contract type; a plain signed
// `>` would misorder values with the high bit set.

program max_usize;

export procedure max_usize(a: int64; b: int64); @returns("rax");
begin max_usize;
    if(a >? b) then
        mov(a, rax);
    else
        mov(b, rax);
    endif;
end max_usize;

begin max_usize;
end max_usize;
