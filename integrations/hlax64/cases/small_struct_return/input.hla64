// small_struct_return.hla64 — build a small aggregate, return a derived scalar.
//
// Phase E (plan §17.5): aggregate layout + field access. HlaX64 returns via a
// register (@returns("rax")), so this exercises struct field layout/offsets
// and returns the summed scalar rather than a by-value struct.
// Field values are staged through registers: a direct `add(p.y, rax)` can
// lower to an unresolved `field:` operand that NASM rejects.
// Downstream: emit Win64 NASM shared-library -> vaa ingest --generator hlax64.
// Honesty: HlaX64 emit / -Wverify != SemASM verified.

program small_struct_return;

struct Point
    x: int64;
    y: int64;
endstruct;

export procedure point_sum(a: int64; b: int64); @returns("rax");
var p: Point;
begin point_sum;
    mov(a, r8);
    mov(b, r9);
    mov(r8, p.x);
    mov(r9, p.y);
    mov(p.x, rax);
    mov(p.y, r10);
    add(r10, rax);
end point_sum;

begin small_struct_return;
end small_struct_return;
