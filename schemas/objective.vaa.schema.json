{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/megaalive/vaa/schemas/objective.vaa.schema.json",
  "title": "VAA optimize objective schema 0.2",
  "description": "Correctness-preserving optimization objective. Lives in a separate TOML file (not task.vaa.toml). Ranking never selects violated/incomplete/failed candidates; must_preserve_status must be true. object_file_bytes is never inferred from source text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "primary",
    "secondary",
    "must_preserve_status",
    "max_candidates"
  ],
  "properties": {
    "schema_version": {
      "enum": ["0.2", "0.1"]
    },
    "primary": {
      "type": "string",
      "enum": [
        "object_file_bytes",
        "object_bytes",
        "source_text_bytes",
        "instruction_count",
        "stack_bytes"
      ]
    },
    "secondary": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "object_file_bytes",
          "object_bytes",
          "source_text_bytes",
          "instruction_count",
          "stack_bytes"
        ]
      }
    },
    "must_preserve_status": {
      "type": "boolean",
      "const": true,
      "description": "Always true: only verified (or explicitly allowed VUP) candidates may win."
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    }
  }
}
